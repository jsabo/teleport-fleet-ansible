---
# Copy to lab/proxmox/vars.yml (gitignored) and fill in.

# Teleport cluster the fleet joins. Log in first: tsh login --proxy=<teleport_proxy>
teleport_proxy: example.teleport.sh:443
teleport_cluster_name: example.teleport.sh
# Managed Updates group the lab VMs report (groups: teleport-resources/autoupdate-config-groups.yaml)
teleport_update_group: default
# Login used through Teleport for verify/harden. Must be one of your roles' logins and
# exist on the VMs (root always does; `ansible` is the cloud-init user).
teleport_ssh_login: root
# Trust-tier labels stamped on the lab VMs. tctl nodes ls and tsh only show nodes your
# roles can access, so a role of yours must match these (e.g. node_labels env: <this>).
lab_env_label: lab
lab_site_label: lab-1

# Proxmox. The token needs VM create/destroy plus Sys.AccessNetwork on the node
# (Proxmox downloads the cloud images itself).
proxmox_endpoint: https://10.0.0.5:8006/
proxmox_api_token: "terraform@pve!provider=00000000-0000-0000-0000-000000000000"
proxmox_node: proxmox
ssh_public_key_file: ~/.ssh/id_ed25519.pub
ssh_private_key_file: ~/.ssh/id_ed25519
