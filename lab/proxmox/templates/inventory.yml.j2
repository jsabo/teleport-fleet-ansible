---
# Generated by lab/proxmox/up.yml from Terraform output. Do not edit; re-run up.yml.
all:
  vars:
    teleport_proxy: {{ teleport_proxy }}
    teleport_cluster_name: {{ teleport_cluster_name }}
    teleport_update_group: {{ teleport_update_group }}
    ansible_user: ansible
    ansible_ssh_private_key_file: {{ ssh_private_key_file }}
    teleport_ssh_login: {{ teleport_ssh_login }}
    teleport_trust_labels:
      env: {{ lab_env_label }}
      site: {{ lab_site_label }}
{% if lab_mirror | default(false) | bool %}
    # Mirror mode: artifacts come from the fleet-mirror VM over HTTPS with a private CA
    # (addressed by IP; the certificate carries an IP SAN), and cdn.teleport.dev resolves
    # to nowhere so a bypass would fail visibly.
    teleport_download_base_url: https://{{ lab_mirror_ip }}/teleport
    teleport_download_ca_cert: {{ playbook_dir }}/.mirror/ca.pem
    teleport_hosts_entries:
      - { ip: 127.0.0.1, name: cdn.teleport.dev }
{% endif %}
  children:
    nodes:
      children:
{% for family in ['debian_family', 'rhel_family'] %}
{% set members = lab_vms | dict2items | selectattr('value.role', 'equalto', 'node') | selectattr('value.family', 'equalto', family) | list %}
{% if members %}
        {{ family }}:
          hosts:
{% for m in members | sort(attribute='key') %}
            {{ m.key }}:
              ip: {{ m.value.ip }}
{% endfor %}
{% endif %}
{% endfor %}
{% set mirrors = lab_vms | dict2items | selectattr('value.role', 'equalto', 'mirror') | list %}
{% if mirrors %}
    mirror:
      hosts:
{% for m in mirrors %}
        {{ m.key }}:
          ip: {{ m.value.ip }}
{% endfor %}
{% endif %}
